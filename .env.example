APP_NAME="OK-Tool"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Zurich
APP_URL=http://localhost:8000

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_CH

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# Lokal: SQLite. Auf Netcup: mysql (MariaDB), siehe DEPLOY.md
DB_CONNECTION=sqlite
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Lokal landen Mails im Log. Auf Netcup: smtp mit dem Postfach aus Plesk
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ok@example.ch"
MAIL_FROM_NAME="${APP_NAME}"

# Push: Schlüssel im Admin-Bereich unter System erzeugen
VAPID_SUBJECT="mailto:ok@example.ch"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

VITE_APP_NAME="${APP_NAME}"
